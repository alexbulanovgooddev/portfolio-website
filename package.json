{
	"name": "portfolio-website",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@11.15.0",
	"engines": {
		"node": "^22.19.0 || ^24.11.0 || >=26.0.0",
		"pnpm": ">=11"
	},
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"prepare": "husky",
		"typecheck": "nuxt typecheck",
		"lint": "pnpm lint:scripts && pnpm lint:styles",
		"lint:fix": "pnpm lint:scripts:fix && pnpm lint:styles:fix",
		"lint:styles": "stylelint \"**/*.{css,scss,vue}\"",
		"lint:styles:fix": "stylelint \"**/*.{css,scss,vue}\" --fix",
		"lint:scripts": "eslint \"**/*.{js,mjs,cjs,ts,vue}\"",
		"lint:scripts:fix": "eslint \"**/*.{js,mjs,cjs,ts,vue}\" --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write ."
	},
	"dependencies": {
		"@fancyapps/ui": "^6.1.14",
		"@nuxt/icon": "^2.5.1",
		"@nuxtjs/color-mode": "^4.0.1",
		"@nuxtjs/seo": "^5.3.14",
		"@pinia/nuxt": "^1.0.2",
		"@vee-validate/nuxt": "^4.15.1",
		"@vee-validate/yup": "^4.15.1",
		"gsap": "^3.15.0",
		"nuxt": "^4.5.2",
		"pinia": "^4.0.3",
		"vue": "^3.5.41",
		"vue-datocms": "^8.1.17",
		"vue-final-modal": "^4.5.5",
		"vue-router": "^5.2.0",
		"yup": "^1.7.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^26.3.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.10.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"postcss-html": "^2.0.0",
		"postcss-scss": "^4.0.9",
		"prettier": "^3.9.6",
		"sass": "^1.103.1",
		"stylelint": "^17.14.1",
		"stylelint-config-recommended-vue": "^2.0.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-prettier": "^5.0.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite-plugin-checker": "^0.14.5",
		"vue-eslint-parser": "^10.4.1",
		"vue-tsc": "^3.3.11"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,vue}": "eslint --fix",
		"*.{css,scss,vue}": "stylelint --fix",
		"*.{js,mjs,cjs,ts,vue,css,scss,json,md,yaml,yml}": "prettier --write"
	}
}
