# Единый LF во всём репозитории — согласовано с .editorconfig и .prettierrc
* text=auto eol=lf

# Бинарные файлы git не трогает
*.woff  binary
*.woff2 binary
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.mp4   binary
*.webm  binary

# Лок-файл: не разрешать конфликты вручную и не шуметь в диффах
pnpm-lock.yaml -diff merge=binary linguist-generated=true
